# This file is entirely optional. POSTGRES_PASSWORD and ADMIN_TOKEN live
# directly in docker-compose.yml now (edit them there -- see the comment
# at the top of that file), not here. Everything below has a working
# default in docker-compose.yml already; copy this to .env only if you
# want to override one of them instead of editing docker-compose.yml itself.

# Optional legacy shared enrollment token (reusable, never expires). Recommended: leave it
# commented out and generate one-time, expiring per-device tokens in the dashboard under
# Agent -> Add a new device. Uncomment only if you rely on the old shared-token workflow.
# ENROLLMENT_TOKEN=replace-with-a-separate-enrollment-token
# Which address/port Docker publishes the plain-HTTP dashboard/API on is set by
# DASHBOARD_ADDRESS near the top of docker-compose.yml, not here -- it's not a
# Compose variable, so .env can't override it. Edit that line directly instead.
#
# Set this to true when the dashboard is served through HTTPS — either the optional
# tls profile below, or your own reverse proxy in front of this server.
# FLEETVIEW_COOKIE_SECURE=true
# Which published image tag to run when deploying from docker-compose.yml alone (no
# source checkout, no local build) via `docker compose pull && docker compose up -d`.
# Defaults to latest; pin it to a specific released version instead if you want upgrades
# to be a deliberate step rather than automatic on every pull, e.g. FLEETVIEW_IMAGE_TAG=0.15.0
# FLEETVIEW_IMAGE_TAG=latest

# TLS termination for agent<->server traffic (see docs/TLS.md) -- the recommended way
# to reach the dashboard from another device. Enable with
# `docker compose --profile tls up -d`. Set this to the LAN IP or hostname agents and
# browsers will actually connect to — Caddy issues a certificate for exactly this value
# using its own private CA (a real CA like Let's Encrypt won't issue for a LAN IP or
# private hostname at all).
# FLEETVIEW_TLS_HOSTNAME=192.168.1.50
# Which address Caddy's HTTPS listener is published on -- defaults to every interface
# (0.0.0.0), since enabling this profile is itself the deliberate choice to make the
# dashboard reachable beyond this machine. Set to a specific LAN/VM IP to restrict it
# to one interface instead. Deliberately separate from DASHBOARD_ADDRESS (the
# plaintext port, set near the top of docker-compose.yml): widening one never
# widens the other.
# FLEETVIEW_TLS_BIND_ADDRESS=0.0.0.0
# Host port Caddy's HTTPS listener is published on. Change only if 8443 conflicts with
# something else on this machine.
# FLEETVIEW_TLS_PORT=8443
# Once the tls profile is enabled, also uncomment FLEETVIEW_COOKIE_SECURE=true above —
# the plain-HTTP server container doesn't know it's being reached over HTTPS through
# Caddy unless told to mark the session cookie Secure regardless.

# Required only if you configure a Proxmox/OPNsense integration (see docs/INTEGRATIONS.md):
# encrypts those credentials at rest, since (unlike every other secret this app stores)
# they have to be reversible for outbound API calls. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FLEETVIEW_SECRET_KEY=replace-with-the-generated-key
