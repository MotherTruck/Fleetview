POSTGRES_DB=fleetview
POSTGRES_USER=fleetview
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Optional legacy shared enrollment token (reusable, never expires). Recommended: leave it
# commented out and generate one-time, expiring per-device tokens in the dashboard under
# Agent -> Add a new device. Uncomment only if you rely on the old shared-token workflow.
# ENROLLMENT_TOKEN=replace-with-a-separate-enrollment-token
# Which address Docker publishes the dashboard/API on.
#   127.0.0.1     Only reachable from the machine running Docker (safest; default).
#   <LAN/VM IP>   Reachable only via that one interface, e.g. 192.168.1.50. Preferred
#                 when the dashboard or agents must be reached from another machine
#                 (for example, a VM host or a second endpoint).
#   0.0.0.0       Reachable on every interface. Use only on a trusted network.
# The server speaks plain HTTP and the admin token can trigger patch jobs, so do not
# expose this to the internet. Run `docker compose up -d` again after changing it.
FLEETVIEW_BIND_ADDRESS=127.0.0.1
FLEETVIEW_PORT=8080
# Set this to true when the dashboard is served through HTTPS — either the optional
# tls profile below, or your own reverse proxy in front of this server.
# FLEETVIEW_COOKIE_SECURE=true
# Which published image tag to run when deploying from docker-compose.yml alone (no
# source checkout, no local build) via `docker compose pull && docker compose up -d`.
# Defaults to latest; pin it to a specific released version instead if you want upgrades
# to be a deliberate step rather than automatic on every pull, e.g. FLEETVIEW_IMAGE_TAG=0.15.0
# FLEETVIEW_IMAGE_TAG=latest

# Optional TLS termination for agent<->server traffic (see docs/TLS.md), off by default.
# Enable with `docker compose --profile tls up -d`. Set this to the LAN IP or hostname
# agents and browsers will actually connect to — Caddy issues a certificate for exactly
# this value using its own private CA (a real CA like Let's Encrypt won't issue for a
# LAN IP or private hostname at all).
# FLEETVIEW_TLS_HOSTNAME=192.168.1.50
# Host port Caddy's HTTPS listener is published on. Change only if 8443 conflicts with
# something else on this machine.
# FLEETVIEW_TLS_PORT=8443
# Once the tls profile is enabled, also uncomment FLEETVIEW_COOKIE_SECURE=true above —
# the plain-HTTP server container doesn't know it's being reached over HTTPS through
# Caddy unless told to mark the session cookie Secure regardless.
