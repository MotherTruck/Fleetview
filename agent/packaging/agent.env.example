# The local Docker server is published on loopback by default.
FLEETVIEW_SERVER_URL=http://127.0.0.1:8080
# One-time token generated in the dashboard (Agent -> Add a new device). It is spent after enrolling.
FLEETVIEW_ENROLLMENT_TOKEN=paste-a-one-time-enrollment-token
FLEETVIEW_STATE_PATH=/var/lib/fleetview-agent/state.json
FLEETVIEW_SCAN_INTERVAL_SECONDS=900
FLEETVIEW_METRICS_INTERVAL_SECONDS=60
FLEETVIEW_JOB_POLL_SECONDS=10
FLEETVIEW_REQUEST_TIMEOUT_SECONDS=60
FLEETVIEW_ALLOW_INSECURE_TLS=false
