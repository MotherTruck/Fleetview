#!/bin/sh
#
# PROVIDE: fleetview_agent
# REQUIRE: NETWORKING DAEMON
# KEYWORD: shutdown
#
# rc.conf(5) variables:
#   fleetview_agent_enable (bool):   set to YES in /etc/rc.conf.d/fleetview_agent to enable
#
# Installed by scripts/install-agent-opnsense.sh as
# /usr/local/etc/rc.d/fleetview-agent. Runs the agent under daemon(8) with
# -r (restart the child if it exits) -- the FreeBSD equivalent of the
# systemd unit's Restart=on-failure, and what a MIGRATE_SERVER job (see
# agent/cmd/fleetview-agent/main.go) relies on to pick up a rewritten
# FLEETVIEW_SERVER_URL after the agent deliberately exits to reconnect.

. /etc/rc.subr

name="fleetview_agent"
rcvar="fleetview_agent_enable"
pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-r -P ${pidfile} -t ${name} /usr/local/bin/fleetview-agent -config /usr/local/etc/fleetview-agent/agent.env"
start_precmd="fleetview_agent_prestart"

fleetview_agent_prestart()
{
	install -d -m 700 /var/db/fleetview-agent
}

load_rc_config "$name"
: "${fleetview_agent_enable:=NO}"

run_rc_command "$1"
